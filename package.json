{
  "name": "luban-ai-mvp",
  "version": "2026.11.24",
  "private": true,
  "description": "Luban AI System MVP: AI-generated structured personal apps with a SQLite-backed runtime.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "postinstall": "npm --prefix vendor/agent-platform install --omit=dev",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "desktop": "electron .",
    "predesktop:pack": "node src/scripts/syncAppVersion.js",
    "desktop:pack": "npm run desktop:prepare && electron-builder --projectDir .desktop-runtime --mac dir --arm64",
    "predesktop:dmg": "node src/scripts/syncAppVersion.js",
    "desktop:dmg": "npm run desktop:prepare && electron-builder --projectDir .desktop-runtime --mac dmg --arm64",
    "test": "node --import ./tests/setup-runtime.mjs --test tests/*.test.js",
    "samples:snapshot": "node src/scripts/snapshotSampleLibrary.js",
    "bench": "node benchmarks/performance.bench.js",
    "desktop:prepare": "node packaging/prepare-desktop.mjs",
    "desktop:win": "npm run desktop:prepare && electron-builder --projectDir .desktop-runtime --win nsis --x64"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.60.0"
  },
  "build": {
    "appId": "ai.luban.desktop.advanced",
    "productName": "鲁班高级版",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "desktop/**/*",
      "public/**/*",
      "src/**/*",
      "agents/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "鲁班高级版 ${version}",
      "artifactName": "Luban-advanced-${version}-${arch}.${ext}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Luban-advanced-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@xiaoya/agent-platform": "file:vendor/agent-platform"
  }
}
